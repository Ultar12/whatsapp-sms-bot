# Telegram BotFather token. Set this in Heroku Config Vars; do not commit the real value.
TELEGRAM_BOT_TOKEN=replace_with_a_new_token
# Telegram chat ID allowed to control registration and bot commands.
TELEGRAM_ADMIN_CHAT_ID=7710721646
# Optional values:
WA_CODE_METHOD=sms
WA_DISPLAY_NAME=My Telegram WhatsApp Bot
# Heroku's filesystem is ephemeral; use an external persistent store for production sessions.
WA_SESSION_DIR=/app/.whatsapp-sms-bot
